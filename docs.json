{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "World Branding",
  "description": "How to use the World Branding app: tasks, projects, content tracker, metrics, and more.",
  "colors": {
    "primary": "#f97316",
    "light": "#fb923c",
    "dark": "#ea580c"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "groups": [
      {
        "group": "Welcome",
        "pages": ["index", "getting-started"]
      },
      {
        "group": "Core concepts",
        "pages": ["tasks", "projects", "documents"]
      },
      {
        "group": "Your tasks",
        "pages": [
          "tasks/north-star",
          "tasks/citizen",
          "tasks/worldcode"
        ]
      },
      {
        "group": "Your projects",
        "pages": [
          "projects/ideation",
          "projects/storytelling",
          "projects/scripting",
          "projects/lead-magnets"
        ]
      },
      {
        "group": "Tools",
        "pages": ["studio", "content-tracker", "metrics", "radar", "weekly-reviews"]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Open the app",
      "href": "https://app.worldbranding.com"
    }
  },
  "footer": {
    "socials": {
      "website": "https://worldbranding.com"
    }
  }
}
